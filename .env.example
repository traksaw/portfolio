# Get these from https://us.posthog.com/project/settings after creating a free PostHog account
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Brave Search RAG demo (/projects/brave-search-rag) — server-side only, no NEXT_PUBLIC_ prefix
# Get a key at https://brave.com/search/api/ (plans from $3/1K queries)
BRAVE_API_KEY=BSA_your_brave_api_key
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_key_here
